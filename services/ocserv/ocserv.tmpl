auth = "plain[passwd=$OCSERV_DIR/ocpasswd]"
tcp-port = $OC_PORT
udp-port = $OC_PORT
listen-proxy-proto = true
#mtu = 1280

#run-as-user = nobody
#run-as-group = daemon

pid-file = /run/ocserv.pid
socket-file = /run/ocserv-socket
#chroot-dir = /var/lib/ocserv
server-cert = $SERVER_CERT
server-key = $SERVER_KEY
isolate-workers = true
max-clients = 256
max-same-clients = 2
rate-limit-ms = 100
server-stats-reset-time = 604800
keepalive = 300
dpd = 90
mobile-dpd = 1800
switch-to-tcp-timeout = 25
try-mtu-discovery = true
cert-user-oid = 0.9.2342.19200300.100.1.1
tls-priorities = "NORMAL:%SERVER_PRECEDENCE:%COMPAT:-VERS-SSL3.0:-VERS-TLS1.0:-VERS-TLS1.1:-VERS-TLS1.3"
auth-timeout = 240
ban-time = 300
max-ban-score = 80
ban-reset-time = 1200
cookie-timeout = 300
deny-roaming = false
rekey-time = 172800
rekey-method = ssl
use-occtl = true
log-level = 2
#   0 default (Same as info)
#   1 basic
#   2 info
#   3 debug
#   4 http
#   8 sensitive
#   9 TLS

device = vpns
predictable-ips = true

cisco-client-compat = true
dtls-legacy = true
client-bypass-protocol = false

camouflage = true
camouflage_secret = "$OC_SECRET"
# опционально
camouflage_realm = "Netxcloud panel"

config-per-group = $OCSERV_DIR/config-per-group/
$OC_DEFAULT_DOMAIN
ipv4-network = $OC_IPV4_CIDR
ping-leases = false

# параметры routes, no-routes, dns, nbns из группового конфига полностью перезаписывают глобальные значения
dns = 14.16.0.1
route = $OC_IPV4_CIDR
route = 10.1.166.0/24
route = 10.200.0.0/24
route = 14.16.0.0/15
route = 14.18.0.0/15
