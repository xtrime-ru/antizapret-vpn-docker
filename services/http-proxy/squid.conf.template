# HTTP proxy port
http_port ${HTTP_PROXY_PORT}

# HTTPS proxy port with self-signed TLS certificate
https_port ${HTTPS_PROXY_PORT} tls-cert=/etc/squid/ssl/cert.pem tls-key=/etc/squid/ssl/key.pem

# Allow connections from any source
acl localnet src all

# Define CONNECT method for tunneling (HTTPS, WebSocket)
acl CONNECT method CONNECT

# Authentication section (injected by init.sh if credentials are set)
${SQUID_AUTH_SECTION}

# Allow CONNECT tunneling on all ports
http_access allow CONNECT

# Allow all traffic from localnet
http_access allow localnet

# Deny everything else
http_access deny all

# Logging
access_log /var/log/squid/access.log
cache_log /var/log/squid/cache.log

# Disable caching
cache deny all

# Anonymization: remove headers that reveal proxy usage
forwarded_for delete
via off
request_header_access X-Forwarded-For deny all
request_header_access Proxy-Connection deny all

# Use Docker embedded DNS resolver
dns_nameservers 127.0.0.11
