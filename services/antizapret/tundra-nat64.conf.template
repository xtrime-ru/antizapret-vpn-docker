program.translator_threads = 1
program.privilege_drop_user = nobody
program.privilege_drop_group = nogroup
io.mode = tun
io.tun.device_path = /dev/net/tun
io.tun.interface_name = ${TUNDRA_INTERFACE}
io.tun.owner_user = nobody
io.tun.owner_group = nogroup
io.tun.multi_queue = no
router.ipv4 = ${TUNDRA_ROUTER_IPV4}
router.ipv6 = fd00:6464::1
router.generated_packet_ttl = 224
addressing.mode = external
addressing.external.transport = unix
addressing.external.unix.path = ${TUNDRA_SOCKET}
addressing.external.unix_tcp.timeout_milliseconds = 400
addressing.external.cache_size.main_addresses = 1024
addressing.external.cache_size.icmp_error_addresses = 64
translator.ipv4.outbound_mtu = 1500
translator.ipv6.outbound_mtu = 1500
translator.6to4.copy_dscp_and_ecn = yes
translator.4to6.copy_dscp_and_ecn = yes
